{
  "name": "Landon and Winnie: Journey to the Stars",
  "short_name": "Landon & Winnie",
  "description": "A star-hopping platformer for Landon and his cat Winnie.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
